# 환경변수 템플릿 — 이 파일을 `.env` 로 복사해서 실제 값 채워넣기
# `.env` 는 .gitignore 되어 있어서 커밋되지 않음.
#
# 이 파일(.env.example)은 팀원이 어떤 환경변수를 세팅해야 하는지 안내용으로 커밋됨.

# Slack Incoming Webhook URL
# 생성 방법: https://api.slack.com/messaging/webhooks
# main.py 의 SLACK_ENABLED=True 일 때만 실제로 사용됨.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# LLM 분석 전략 (휴리스틱 실패 시 폴백으로 OpenAI 호출)
# main.py 의 USE_LLM=True 일 때만 사용됨. 발급: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
